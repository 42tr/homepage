---
import '../style.css';
const { title = '42tr · 个人主页', description = '42tr 的个人主页：全栈开发、系统架构与 AI 探索。', ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site) : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111216" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/star.png" type="image/png" />
    <link rel="alternate" type="application/rss+xml" title="42tr 博客 RSS" href="/blog/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <slot name="head" />
  </head>
  <body><slot /></body>
</html>
