---
import Page from '../layouts/Page.astro';
import Home from '../views/Home.vue';
---
<Page><Home /></Page>
<script>
  const clock = document.querySelector('.clock-card');
  if (clock) {
    const time = clock.querySelector('.time');
    const date = clock.querySelector('.date');
    const week = clock.querySelector('.week');
    const greeting = clock.querySelector('.greeting');
    const update = () => {
      const now = new Date();
      time.textContent = now.toLocaleTimeString('zh-CN', { hour12: false });
      date.textContent = `${now.getFullYear()}年${now.getMonth() + 1}月${now.getDate()}日`;
      week.textContent = `星期${'日一二三四五六'[now.getDay()]}`;
      const hour = now.getHours();
      greeting.textContent = hour < 6 ? '夜深了' : hour < 9 ? '早上好' : hour < 12 ? '上午好' : hour < 14 ? '中午好' : hour < 18 ? '下午好' : '晚上好';
    };
    update();
    let timer = setInterval(update, 1000);
    document.addEventListener('visibilitychange', () => {
      clearInterval(timer);
      if (!document.hidden) { update(); timer = setInterval(update, 1000); }
    });
  }
  const leetcode = document.querySelector('.leetcode-card');
  if (leetcode) {
    // The card renders the build-time snapshot; the backend refreshes it every 10 minutes.
    const node = (selector) => leetcode.querySelector(selector);
    const whole = (value) => Number.isSafeInteger(value) && value >= 0 ? value : null;
    fetch('/api/leetcode', { cache: 'no-store', signal: AbortSignal.timeout(15000) })
      .then((response) => response.ok ? response.json() : Promise.reject())
      .then((snapshot) => {
        const total = whole(snapshot.question_total);
        const solved = whole(snapshot.question_solved);
        if (!total || solved === null || solved > total) return;
        for (const field of ['rating', 'global_ranking', 'global_total_participants', 'local_ranking', 'local_total_participants']) {
          const value = whole(snapshot[field]);
          const target = node(`[data-leetcode="${field}"]`);
          if (value !== null && target) target.textContent = value;
        }
        const questions = node('[data-leetcode="questions"]');
        if (questions) questions.textContent = `${solved} / ${total}`;
        const fill = node('[data-leetcode-fill]');
        if (fill) fill.style.width = `${Math.round(solved / total * 100)}%`;
        const rating = whole(snapshot.rating);
        const ring = node('[data-leetcode-ring]');
        if (rating !== null && ring) ring.setAttribute('stroke-dasharray', `${rating / 3000 * 326.73} 326.73`);
      })
      .catch(() => {});
  }
</script>
